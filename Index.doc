<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Estructura antes de la adquisición · Pitaco y Draftea</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#f4f5f7; --grid:#e6e8ee; --ink:#191b2b; --ink-2:#5c6273; --line:#dcdfe7; --card:#ffffff;
    --stay:#17876a; --stay-bg:#e2f3ec; --stay-tx:#0e5a44; --stay-wash:#ffffff;
    --vol:#3b82c4;  --vol-bg:#e5eefb;  --vol-tx:#24557f;  --vol-wash:#f5f9fe;
    --inv:#7c5cff;  --inv-bg:#ece7ff;  --inv-tx:#4a37a8;  --inv-wash:#f8f6ff;
    --lmar:#d64550; --lmar-bg:#fbe4e6; --lmar-tx:#a12730; --lmar-wash:#fdf5f5;
    --lmay:#e08a2b; --lmay-bg:#fbeed9; --lmay-tx:#8f561a; --lmay-wash:#fdf8f0;
    --pdv:#8b93a7;  --pdv-bg:#ebedf2;  --pdv-tx:#4f5665;  --pdv-wash:#f7f8fa;
    --new:#0ea5a5;  --new-bg:#d7f2f0;  --new-tx:#0a6b68;  --new-wash:#f2fbfa;
    --display:'Space Grotesk', -apple-system, sans-serif;
    --body:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;font-family:var(--body);background:var(--paper);color:var(--ink);overflow:hidden}
  #app{display:flex;flex-direction:column;height:100vh}
  header{padding:12px 22px 14px;background:#fff;border-bottom:1px solid var(--line);z-index:10}

  /* company tabs */
  .tabs{display:inline-flex;gap:4px;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:4px;margin-bottom:14px}
  .tabs button{font-family:var(--display);font-size:14px;font-weight:600;border:none;background:none;color:var(--ink-2);
    padding:8px 22px;border-radius:9px;cursor:pointer;letter-spacing:.2px}
  .tabs button.on{background:var(--ink);color:#fff}

  .toprow{display:flex;align-items:flex-end;gap:22px;flex-wrap:wrap}
  .titleblock h1{font-family:var(--display);font-size:20px;font-weight:700;margin:0;letter-spacing:-.2px}
  .titleblock .sub{font-size:12.5px;color:var(--ink-2);margin-top:3px}
  .spacer{flex:1}

  .kpis{display:flex;align-items:center;gap:26px;margin-top:15px;flex-wrap:wrap}
  .kpi{display:flex;flex-direction:column;gap:1px}
  .kpi .v{font-family:var(--display);font-size:26px;font-weight:700;line-height:1}
  .kpi .k{font-size:11px;color:var(--ink-2);letter-spacing:.3px;text-transform:uppercase;font-weight:600}
  .kpi.drop .v{color:var(--lmar)}
  .barwrap{flex:1;min-width:260px}
  .barwrap .caption{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-2);margin-bottom:5px}
  .bar{display:flex;height:16px;border-radius:6px;overflow:hidden;border:1px solid var(--line)}
  .bar span{display:block;height:100%}
  .bar span:hover{filter:brightness(.92)}

  #stage{position:relative;flex:1;overflow:hidden;cursor:grab;
    background:radial-gradient(circle at 1px 1px, var(--grid) 1px, transparent 0) 0 0/24px 24px, var(--paper)}
  #stage.grabbing{cursor:grabbing}
  svg#tree{width:100%;height:100%;display:block}
  .link{fill:none;stroke:#c4c8d4;stroke-width:1.5px}
  .link.on-path{stroke:var(--ink);stroke-width:2.2px}

  .node-card{height:100%;border-radius:11px;padding:9px 12px 9px 13px;background:var(--card);
    border:1px solid var(--line);border-left:6px solid var(--pdv);
    display:flex;flex-direction:column;justify-content:center;gap:3px;
    box-shadow:0 1px 3px rgba(20,20,50,.07);cursor:pointer;transition:transform .12s,box-shadow .12s,opacity .2s;overflow:hidden}
  .node-card:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(20,20,50,.14)}
  .node-inner{position:relative}
  .node-name{font-size:13px;font-weight:600;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink)}
  .node-role{font-size:11px;color:var(--ink-2);line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .node-tags{display:flex;gap:5px;align-items:center;margin-top:2px}
  .tag{font-size:9px;font-weight:700;letter-spacing:.3px;padding:2px 7px;border-radius:20px;line-height:1;white-space:nowrap}
  .tag.dept{background:#eef0f5;color:#5a6072;text-transform:uppercase;font-size:8.5px}

  .st-stay{border-left-color:var(--stay);background:var(--stay-wash)}  .st-stay .tag.status{background:var(--stay-bg);color:var(--stay-tx)}
  .st-vol{border-left-color:var(--vol);background:var(--vol-wash)}     .st-vol .tag.status{background:var(--vol-bg);color:var(--vol-tx)}
  .st-inv{border-left-color:var(--inv);background:var(--inv-wash)}     .st-inv .tag.status{background:var(--inv-bg);color:var(--inv-tx)}
  .st-lmar{border-left-color:var(--lmar);background:var(--lmar-wash)}  .st-lmar .tag.status{background:var(--lmar-bg);color:var(--lmar-tx)}
  .st-lmay{border-left-color:var(--lmay);background:var(--lmay-wash)}  .st-lmay .tag.status{background:var(--lmay-bg);color:var(--lmay-tx)}
  .st-pdv{border-left-color:var(--pdv);background:var(--pdv-wash)}     .st-pdv .tag.status{background:var(--pdv-bg);color:var(--pdv-tx)}
  .st-new{border-left-color:var(--new);background:var(--new-wash)}     .st-new .tag.status{background:var(--new-bg);color:var(--new-tx)}
  .st-root{border-left-color:var(--ink);background:var(--ink)}
  .st-root .node-name,.st-root .node-role{color:#fff}

  .node.dim .node-card{opacity:.24;box-shadow:none}
  .node.match .node-card{outline:3px solid #ffcf3f;outline-offset:1px}

  .toggle{position:absolute;left:50%;transform:translateX(-50%);bottom:-13px;min-width:26px;height:26px;padding:0 9px;
    border-radius:14px;background:#fff;border:1.5px solid var(--line);display:flex;align-items:center;justify-content:center;
    font-size:12.5px;font-weight:700;color:var(--ink);box-shadow:0 3px 7px rgba(20,20,50,.18);white-space:nowrap;font-family:var(--display)}

  .floaters{position:absolute;right:16px;bottom:16px;display:flex;flex-direction:column;gap:8px;z-index:5}
  .zbtn{width:38px;height:38px;border-radius:10px;background:#fff;border:1px solid var(--line);color:var(--ink);
    font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(20,20,50,.08)}
  .zbtn:hover{border-color:var(--ink)}
  .zbtn.small{font-size:11px;font-weight:600;font-family:var(--body)}

  .legend{position:absolute;left:16px;bottom:16px;background:#fff;border:1px solid var(--line);border-radius:12px;
    padding:12px 14px;z-index:5;box-shadow:0 8px 22px rgba(20,20,50,.12)}
  .legend h3{margin:0 0 9px;font-size:10px;letter-spacing:.7px;text-transform:uppercase;color:var(--ink-2);font-weight:700}
  .legend .row{display:flex;align-items:center;gap:9px;margin:5px 0;font-size:12px;cursor:pointer;user-select:none}
  .legend .row.off{opacity:.4}
  .legend .sw{width:16px;height:16px;border-radius:5px;flex:none}
  .legend .ct{margin-left:auto;font-family:var(--display);font-weight:600;color:var(--ink-2);font-size:11px;padding-left:12px}

  .syncpill{position:absolute;left:16px;top:16px;background:#fff;border:1px solid var(--line);border-radius:20px;
    padding:6px 12px;font-size:11px;z-index:5;color:var(--ink-2);display:flex;align-items:center;gap:7px;box-shadow:0 2px 6px rgba(20,20,50,.08)}
  .dotsync{width:8px;height:8px;border-radius:50%;background:#9aa0ad;flex:none}
  .dotsync.live{background:var(--stay);box-shadow:0 0 0 3px rgba(23,135,106,.16)}
  .dotsync.snap{background:var(--lmay)}
  .dotsync.loading{background:var(--vol);animation:pulse 1s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}

  .field{position:relative;display:flex;align-items:center}
  .field svg{position:absolute;left:11px;width:15px;height:15px;color:var(--ink-2);pointer-events:none}
  input[type="search"]{font-family:var(--body);background:var(--paper);border:1px solid var(--line);color:var(--ink);
    border-radius:9px;padding:8px 12px 8px 32px;font-size:13px;outline:none;width:220px}
  input[type="search"]:focus{border-color:var(--ink)}
  ::placeholder{color:var(--ink-2)}
  @media (max-width:760px){ .legend{display:none} input[type="search"]{width:130px} .kpi.hideSm{display:none} }
</style>
</head>
<body>
<div id="app">
  <header>
    <div class="tabs" id="tabs">
      <button data-ds="pitaco" class="on">Pitaco</button>
      <button data-ds="draftea">Draftea</button>
    </div>
    <div class="toprow">
      <div class="titleblock">
        <h1 id="title">Pitaco · Estructura antes de la adquisición</h1>
        <div class="sub">Organigrama y cambios por motivo · diciembre 2025</div>
      </div>
      <div class="spacer"></div>
      <div class="field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" id="search" placeholder="Buscar persona o rol…" autocomplete="off">
      </div>
    </div>
    <div class="kpis">
      <div class="kpi"><span class="v" id="kTotal">0</span><span class="k">Personas</span></div>
      <div class="kpi"><span class="v" id="kStay" style="color:var(--stay)">0</span><span class="k">Siguen</span></div>
      <div class="kpi drop"><span class="v" id="kOut">0</span><span class="k">Salidas</span></div>
      <div class="kpi" id="kpiNew" style="display:none"><span class="v" id="kNew" style="color:var(--new)">0</span><span class="k">Nuevos ingresos</span></div>
      <div class="kpi drop hideSm"><span class="v" id="kPct">0%</span><span class="k">% salidas</span></div>
      <div class="barwrap">
        <div class="caption"><span id="barCap">Composición de la estructura</span><span id="barTot"></span></div>
        <div class="bar" id="bar"></div>
      </div>
    </div>
  </header>

  <div id="stage">
    <svg id="tree"><g id="viewport"><g id="links"></g><g id="nodes"></g></g></svg>
    <div class="syncpill" id="syncpill"><span class="dotsync" id="dotsync"></span><span id="syncText">Snapshot local</span></div>
    <div class="legend" id="legend"><h3>Motivo</h3></div>
    <div class="floaters">
      <button class="zbtn" id="zoomIn">+</button>
      <button class="zbtn" id="zoomOut">−</button>
      <button class="zbtn small" id="fit">Ajustar</button>
    </div>
  </div>
</div>

