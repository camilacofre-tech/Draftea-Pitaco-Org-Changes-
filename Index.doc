/* ===== status por motivo ===== */
const STATUS = {
  stay:{cls:'st-stay',color:'#17876a',label:'Sigue'},
  vol: {cls:'st-vol', color:'#3b82c4',label:'Voluntaria'},
  inv: {cls:'st-inv', color:'#7c5cff',label:'Involuntaria'},
  lmar:{cls:'st-lmar',color:'#d64550',label:'Layoff marzo'},
  lmay:{cls:'st-lmay',color:'#e08a2b',label:'Layoff mayo'},
  pdv: {cls:'st-pdv', color:'#8b93a7',label:'PDV'},
  new: {cls:'st-new', color:'#0ea5a5',label:'Nuevo ingreso'},
};
const LEGEND_ORDER=['stay','vol','inv','lmar','lmay','pdv','new'];
const DEPARTURES=['vol','inv','lmar','lmay','pdv'];
function reasonToStatus(r){r=(r||'').trim().toLowerCase();
  if(!r)return 'stay'; if(r.startsWith('vol'))return 'vol'; if(r.startsWith('invol'))return 'inv';
  if(r.includes('marzo'))return 'lmar'; if(r.includes('mayo'))return 'lmay'; if(r==='pdv')return 'pdv';
  if(r.startsWith('new'))return 'new'; return 'pdv';}

/* ===== CSV ===== */
function parseCSV(text){const rows=[];let row=[],field='',q=false;text=text.replace(/\r\n/g,'\n').replace(/\r/g,'\n');
  for(let i=0;i<text.length;i++){const c=text[i];
    if(q){if(c==='"'){if(text[i+1]==='"'){field+='"';i++;}else q=false;}else field+=c;}
    else{if(c==='"')q=true;else if(c===','){row.push(field);field='';}else if(c==='\n'){row.push(field);rows.push(row);row=[];field='';}else field+=c;}}
  if(field.length||row.length){row.push(field);rows.push(row);}
  return rows.filter(r=>r.some(x=>x.trim()!==''));}
const norm=s=>(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/\s+/g,' ').trim();
function headerKey(h){const n=norm(h);
  if(n==='name')return 'name'; if(n==='brand')return 'brand';
  if(n==='diretory'||n==='directory'||n==='area')return 'dept';
  if(n==='subarea')return 'subarea'; if(n==='actual role'||n==='role')return 'role';
  if(n==='direct leader'||n==='leader')return 'leader'; if(n==='area manager')return 'areaManager';
  if(n==='reason')return 'reason'; if(n==='propuesta roles')return 'proposal'; return null;}

/* ===== modelo ===== */
const PARTICLES=new Set(['de','da','do','dos','das','del','la','von','van','di','du']);
let MODEL=null;
function buildModel(csvText){
  const rows=parseCSV(csvText); const header=rows[0].map(headerKey); const people=[];
  for(let r=1;r<rows.length;r++){const rec={};rows[r].forEach((v,i)=>{if(header[i])rec[header[i]]=(v||'').trim();});if(rec.name)people.push(rec);}
  people.forEach((p,i)=>{p._i=i;p._n=norm(p.name);p._tok=p._n.split(' ').filter(Boolean);p.status=reasonToStatus(p.reason);});
  const byName=new Map();people.forEach(p=>{if(!byName.has(p._n))byName.set(p._n,p);});
  function resolve(nameRaw,self){const key=norm(nameRaw);if(!key||key==='-')return null;
    if(byName.has(key)){const p=byName.get(key);return p._i===self?null:p._i;}
    const lt=key.split(' ').filter(Boolean);let best=null,ex=Infinity;
    for(const p of people){if(p._i===self)continue;if(lt.every(t=>p._tok.includes(t))){const e=p._tok.length-lt.length;if(e<ex){ex=e;best=p._i;}}}
    if(best!==null)return best;
    const sur=[...lt].reverse().find(t=>!PARTICLES.has(t)&&t.length>=4);const ini=lt[0]?lt[0][0]:'';
    if(sur&&ini){const c=people.filter(p=>p._i!==self&&p._tok.includes(sur)&&p._tok.some(w=>w[0]===ini));if(c.length===1)return c[0]._i;}
    return null;}
  const parentOf=new Array(people.length).fill(null);const roots=[];
  people.forEach(p=>{const lead=norm(p.leader);
    if(lead===''||lead==='-'){roots.push(p._i);parentOf[p._i]='ROOTNODE';return;}
    let pi=resolve(p.leader,p._i);if(pi===null&&norm(p.areaManager))pi=resolve(p.areaManager,p._i);
    parentOf[p._i]=(pi===null?'ORPHAN':pi);});
  const ceo=roots.length?roots[0]:null;
  people.forEach(p=>{if(parentOf[p._i]==='ORPHAN')parentOf[p._i]=(ceo!=null?ceo:'ROOTNODE');});
  const counts={};LEGEND_ORDER.forEach(k=>counts[k]=0);people.forEach(p=>counts[p.status]++);
  MODEL={people,parentOf,roots,counts};return MODEL;}

const SYN_ROOT={_i:-1,name:'',role:'',dept:'',status:'root',synthRoot:true};
function tierRank(p){const r=norm(p.role);
  if(/chairman/.test(r))return 0;
  if(/\bceo\b|\bcfo\b|\bcto\b|\bcpo\b|\bcmo\b|chief/.test(r))return 1;
  if(/\bvp\b/.test(r))return 2; if(/head of/.test(r))return 3;
  if(/manager|leader|lead|coordinator/.test(r))return 4; return 5;}
function buildNested(){
  const {people,parentOf}=MODEL; const kids=new Map();
  const add=(k,c)=>{if(!kids.has(k))kids.set(k,[]);kids.get(k).push(c);};
  people.forEach(p=>{if(p._i<0)return;const par=parentOf[p._i];
    if(par==='ROOTNODE')add('ROOT',p._i);else add(par,p._i);});
  const visited=new Set();
  function make(idx){visited.add(idx);const p=people[idx];
    const cs=(kids.get(idx)||[]).filter(c=>!visited.has(c)).map(make);
    cs.sort((a,b)=>{const t=tierRank(a.data)-tierRank(b.data);return t||a.data.name.localeCompare(b.data.name,'es');});
    return {data:p,children:cs};}
  const top=(kids.get('ROOT')||[]).filter(c=>!visited.has(c)).map(make);
  top.sort((a,b)=>{const t=tierRank(a.data)-tierRank(b.data);return t||a.data.name.localeCompare(b.data.name,'es');});
  return {data:SYN_ROOT,children:top};}

/* ===== render D3 ===== */
const NODE_W=228,NODE_H=78,GAP_X=30,GAP_Y=142;
const svg=d3.select('#tree'),gViewport=d3.select('#viewport'),gLinks=d3.select('#links'),gNodes=d3.select('#nodes');
let root,i=0,searchTerm='',hidden=new Set(),curKey='pitaco';
const zoom=d3.zoom().scaleExtent([0.12,2]).on('zoom',e=>gViewport.attr('transform',e.transform));
svg.call(zoom).on('dblclick.zoom',null);
document.getElementById('stage').addEventListener('mousedown',()=>document.getElementById('stage').classList.add('grabbing'));
window.addEventListener('mouseup',()=>document.getElementById('stage').classList.remove('grabbing'));
const treeLayout=d3.tree().nodeSize([NODE_W+GAP_X,GAP_Y]);
function collapse(d){if(d.children){d._children=d.children;d._children.forEach(collapse);d.children=null;}}
function totalDesc(d){const k=d.children||d._children||[];let n=k.length;k.forEach(c=>n+=totalDesc(c));return n;}
function statusCls(p){if(p.synthRoot)return 'st-root';return STATUS[p.status]?STATUS[p.status].cls:'st-pdv';}
function matchesSearch(d){if(!searchTerm)return false;const t=norm(searchTerm);const p=d.data.data;
  return norm(p.name).includes(t)||norm(p.role).includes(t);}

function loadTree(){
  const nested=buildNested();
  root=d3.hierarchy(nested,d=>d.children);root.x0=0;root.y0=0;
  if(root.children)root.children.forEach(c=>{if(c.children)c.children.forEach(collapse);});
  update(root);setTimeout(fitToScreen,60);}

function update(source){
  const nodes=treeLayout(root).descendants(),links=root.links();
  nodes.forEach(d=>d.y=d.depth*GAP_Y);
  const onPath=new Set();
  if(searchTerm)root.each(d=>{if(matchesSearch(d)){let a=d;while(a){onPath.add(a);a=a.parent;}}});
  const node=gNodes.selectAll('g.node').data(nodes,d=>d.id||(d.id=++i));
  const enter=node.enter().append('g').attr('class','node')
    .attr('transform',()=>`translate(${source.x0-NODE_W/2},${source.y0-NODE_H/2})`).style('opacity',0);
  enter.append('foreignObject').attr('width',NODE_W).attr('height',NODE_H+20).append('xhtml:div').attr('class','node-inner');
  const all=enter.merge(node);
  all.select('.node-inner').html(d=>{const p=d.data.data;
    if(p.synthRoot){return `<div class="node-card st-root" style="height:${NODE_H}px">
      <div class="node-name" style="font-family:var(--display);font-size:15px">${DATASETS[curKey].label}</div>
      <div class="node-role">Estructura antes de la adquisición</div></div>`;}
    const kids=(d.children?d.children.length:0)+(d._children?d._children.length:0);
    const collapsed=!!d._children,tot=totalDesc(d),st=STATUS[p.status];
    const dept=p.dept?`<span class="tag dept">${p.dept}</span>`:'';
    const statusTag=`<span class="tag status">${st?st.label:''}</span>`;
    const toggle=kids?`<div class="toggle">${collapsed?'+'+tot:'−'}</div>`:'';
    return `<div class="node-card ${statusCls(p)}" style="height:${NODE_H}px">
      <div class="node-name">${p.name.trim()}</div>
      <div class="node-role">${(p.role||'').trim()||'—'}</div>
      <div class="node-tags">${statusTag}${dept}</div></div>${toggle}`;});
  all.classed('dim',d=>{const p=d.data.data;if(p.synthRoot)return false;return hidden.has(p.status);})
     .classed('match',d=>matchesSearch(d));
  all.transition().duration(400).attr('transform',d=>`translate(${d.x-NODE_W/2},${d.y-NODE_H/2})`).style('opacity',1);
  all.select('.node-inner').on('click',(e,d)=>{e.stopPropagation();
    if(d.children){d._children=d.children;d.children=null;}else if(d._children){d.children=d._children;d._children=null;}update(d);});
  node.exit().transition().duration(280).attr('transform',()=>`translate(${source.x-NODE_W/2},${source.y-NODE_H/2})`).style('opacity',0).remove();
  const link=gLinks.selectAll('path.link').data(links,d=>d.target.id);
  const diagonal=d3.linkVertical().x(d=>d.x).y(d=>d.y);
  const le=link.enter().insert('path','g').attr('class','link').attr('d',()=>{const o={x:source.x0,y:source.y0};return diagonal({source:o,target:o});});
  le.merge(link).transition().duration(400)
    .attr('class',d=>onPath.has(d.target)&&onPath.has(d.source)?'link on-path':'link')
    .attr('d',d=>{const s={x:d.source.x,y:d.source.y+NODE_H/2},t={x:d.target.x,y:d.target.y-NODE_H/2};return diagonal({source:s,target:t});});
  link.exit().transition().duration(280).attr('d',()=>{const o={x:source.x,y:source.y};return diagonal({source:o,target:o});}).remove();
  nodes.forEach(d=>{d.x0=d.x;d.y0=d.y;});}

function fitToScreen(){const b=gNodes.node().getBBox();if(!b.width)return;
  const s=document.getElementById('stage').getBoundingClientRect();const pad=90;
  const scale=Math.min((s.width-pad)/b.width,(s.height-pad)/b.height,1.15);
  svg.transition().duration(500).call(zoom.transform,d3.zoomIdentity.translate(s.width/2-(b.x+b.width/2)*scale,36-b.y*scale+16).scale(scale));}
function centerOn(d,scale=0.95){const s=document.getElementById('stage').getBoundingClientRect();
  svg.transition().duration(500).call(zoom.transform,d3.zoomIdentity.translate(s.width/2-d.x*scale,s.height/2-d.y*scale).scale(scale));}

/* ===== header (KPIs, barra, leyenda) ===== */
function renderHeader(){
  const c=MODEL.counts,total=MODEL.people.length,stay=c.stay;
  const out=DEPARTURES.reduce((s,k)=>s+c[k],0),nuevos=c.new;
  document.getElementById('kTotal').textContent=total;
  document.getElementById('kStay').textContent=stay;
  document.getElementById('kOut').textContent=out;
  document.getElementById('kPct').textContent='−'+Math.round(out/total*100)+'%';
  const nk=document.getElementById('kpiNew');
  if(nuevos>0){nk.style.display='';document.getElementById('kNew').textContent=nuevos;}else nk.style.display='none';
  document.getElementById('barTot').textContent=total+' personas';
  const bar=document.getElementById('bar');bar.innerHTML='';
  LEGEND_ORDER.forEach(k=>{if(!c[k])return;const s=document.createElement('span');
    s.style.width=(c[k]/total*100)+'%';s.style.background=STATUS[k].color;s.title=STATUS[k].label+': '+c[k];bar.appendChild(s);});
  const lg=document.getElementById('legend');lg.querySelectorAll('.row').forEach(n=>n.remove());
  LEGEND_ORDER.forEach(k=>{if(!c[k])return;const row=document.createElement('div');row.className='row';if(hidden.has(k))row.classList.add('off');
    row.innerHTML=`<span class="sw" style="background:${STATUS[k].color}"></span><span>${STATUS[k].label}</span><span class="ct">${c[k]}</span>`;
    row.onclick=()=>{if(hidden.has(k))hidden.delete(k);else hidden.add(k);row.classList.toggle('off');update(root);};
    lg.appendChild(row);});}

/* ===== sincronización en vivo (data-*.csv publicado por la GitHub Action) ===== */
function setSync(state,text){const d=document.getElementById('dotsync');d.className='dotsync '+state;document.getElementById('syncText').textContent=text;}
async function autoSync(key){
  const src=DATASETS[key].src; if(!src){setSync('snap','Snapshot local');return;}
  setSync('loading','Sincronizando…');
  try{
    const u=src+(src.includes('?')?'&':'?')+'_='+Date.now();
    const res=await fetch(u,{cache:'no-store'}); if(!res.ok) throw 0;
    const txt=await res.text();
    if(curKey!==key) return;                                  // el usuario cambió de pestaña
    if(!/direct leader|reason/i.test(txt)) throw 0;           // respuesta inesperada
    buildModel(txt); renderHeader(); loadTree();
    setSync('live','Actualizado '+new Date().toLocaleString('es-CL',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}));
  }catch(e){ if(curKey===key) setSync('snap','Snapshot local'); }
}

/* ===== cambio de pestaña ===== */
function loadDataset(key){
  curKey=key;hidden=new Set();searchTerm='';document.getElementById('search').value='';
  document.querySelectorAll('#tabs button').forEach(b=>b.classList.toggle('on',b.dataset.ds===key));
  document.getElementById('title').textContent=DATASETS[key].label+' · Estructura antes de la adquisición';
  SYN_ROOT.name=DATASETS[key].label;
  buildModel(DATASETS[key].csv);renderHeader();loadTree();
  autoSync(key);}

/* ===== controles ===== */
document.getElementById('tabs').addEventListener('click',e=>{const b=e.target.closest('button');if(b)loadDataset(b.dataset.ds);});
document.getElementById('zoomIn').onclick=()=>svg.transition().call(zoom.scaleBy,1.3);
document.getElementById('zoomOut').onclick=()=>svg.transition().call(zoom.scaleBy,1/1.3);
document.getElementById('fit').onclick=fitToScreen;
let stmr;document.getElementById('search').oninput=e=>{searchTerm=e.target.value.trim();clearTimeout(stmr);stmr=setTimeout(()=>{
  if(searchTerm){let first=null;root.each(d=>{if(matchesSearch(d)){if(!first)first=d;let a=d.parent;while(a){if(a._children){a.children=a._children;a._children=null;}a=a.parent;}}});update(root);if(first)setTimeout(()=>centerOn(first),120);}else update(root);},200);};

/* ===== init ===== */
loadDataset('pitaco');

</script>
</body>
</html>
